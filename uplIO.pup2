// 
// uplIO.pup2
// -------------------------------------
// 
// I/O Functions file. Immediate axis-scoped digital/analog I/O.
// 
// Naming: uplIO + <controller keyword> + <action>
//   e.g. uplIODInPortRead, uplIODOutPortWrite, uplIODInModeConfig
// 
// Section order: Digital inputs -> Digital outputs -> Analog input -> Analog output
// Within each section: Config -> Read -> Write
//
// NOTE: Functions modify AChooseAxis[AProgThread] according to lAxis_.
// On single-axis drives, use A_AXIS only.
//
// Per-bit writes: pass IO_NUM_n and IO_WRITE_SET / IO_WRITE_CLEAR (uplIO.puh2).
// Full-port writes: uplIODInLogWrite / uplIODOutPortWrite.
//
// Maintainer: Yoav
// Created at: 06/01/2026
// version:    5.0.0
//


#include uphGeneralConstants.puh2
#include uplIO.puh2


// =============================================================================
// Digital inputs
// =============================================================================

// --- Config (DInMode[]) ---

// Configure digital input mode
// -- lAxis_      : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                  Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- InputIndex_ : Digital input number (1-based index into DInMode[])
// -- Mode_       : Input mode value [DINMODE_* constants in uphGeneralConstants.puh2]
function: uplIODInModeConfig(l:lAxis_, l:InputIndex_, l:Mode_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDInMode[InputIndex_] = Mode_
	
endoffunc


// --- Read (DInPort) ---

// Read full digital input port
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- Returns  : 32-bit DInPort value (bit n-1 = input #n)
function: l:DInPortValue_ = uplIODInPortRead(l:lAxis_)
	
	AChooseAxis[AProgThread] = lAxis_
	DInPortValue_ = PDInPort
	
endoffunc


// --- Bitwise Read (DInPort) ---

// Read masked digital input bit(s)
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- IoMask_  : Bit mask, IO_NUM_n from uplIO.puh2 (e.g. IO_NUM_1)
// -- Returns  : DInPort masked by IoMask_ (non-zero if any selected input is high)
function: l:InputValue_ = uplIODInPortReadBit(l:lAxis_, l:IoMask_)
	
	AChooseAxis[AProgThread] = lAxis_
	InputValue_ = PDInPort & IoMask_
	
endoffunc


// --- Write (DInLog) ---

// Write full digital input log port
// -- lAxis_       : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                   Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- DInLogValue_ : 32-bit value written to DInLog
function: uplIODInLogWrite(l:lAxis_, l:DInLogValue_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDInLog = DInLogValue_
	
endoffunc


// --- Bitwise Write (DInLog) ---

// Set or clear digital input log bit(s)
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- IoMask_  : Bit mask, IO_NUM_n from uplIO.puh2 (e.g. IO_NUM_1)
// -- Action_  : IO_WRITE_SET or IO_WRITE_CLEAR
function: uplIODInLogWriteBit(l:lAxis_, l:IoMask_, l:Action_)
	
	AChooseAxis[AProgThread] = lAxis_
	
	switch (Action_)
		case IO_WRITE_SET
			PDInLog = PDInLog | IoMask_
			break
		case IO_WRITE_CLEAR
			PDInLog = PDInLog & (IO_MASK_ALL ^ IoMask_)
			break
		default
			break
	end
	
endoffunc


// Toggle digital input log bit(s)
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- IoMask_  : Bit mask, IO_NUM_n from uplIO.puh2 (e.g. IO_NUM_1)
function: uplIODInLogToggleBits(l:lAxis_, l:IoMask_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDInLog = PDInLog ^ IoMask_
	
endoffunc

// =============================================================================
// Digital outputs
// =============================================================================

// --- Config (DOutMode[], DOutSelect[], DOutType) ---

// Configure digital output mode
// -- lAxis_       : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                   Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- OutputIndex_ : Digital output number (1-based index into DOutMode[])
// -- Mode_        : Output mode value [DOUTMODE_* constants in uphGeneralConstants.puh2]
function: uplIODOutModeConfig(l:lAxis_, l:OutputIndex_, l:Mode_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDOutMode[OutputIndex_] = Mode_
	
endoffunc


// Configure digital output select
// -- lAxis_       : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                   Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- SelectIndex_ : Select number (1-based index into DOutSelect[])
// -- SelectValue_ : Value written to DOutSelect[SelectIndex_]
function: uplIODOutSelectConfig(l:lAxis_, l:SelectIndex_, l:SelectValue_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDOutSelect[SelectIndex_] = SelectValue_
	
endoffunc


// Configure digital output type
// -- lAxis_         : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                     Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- DOutTypeValue_ : 32-bit DOutType value (per-bit DOUTTYPE_SINK / DOUTTYPE_SOURCE)
function: uplIODOutTypeConfig(l:lAxis_, l:DOutTypeValue_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDOutType = DOutTypeValue_
	
endoffunc


// --- Read (DOutPort) ---

// Read full digital output port
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- Returns  : 32-bit DOutPort value (bit n-1 = output #n)
function: l:DOutPortValue_ = uplIODOutPortRead(l:lAxis_)
	
	AChooseAxis[AProgThread] = lAxis_
	DOutPortValue_ = PDOutPort
	
endoffunc


// --- Bitwise Read (DOutPort) ---

// Read masked digital output bit(s)
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- IoMask_  : Bit mask, IO_NUM_n from uplIO.puh2 (e.g. IO_NUM_1)
// -- Returns  : DOutPort masked by IoMask_ (non-zero if any selected output is high)
function: l:OutputValue_ = uplIODOutPortReadBit(l:lAxis_, l:IoMask_)
	
	AChooseAxis[AProgThread] = lAxis_
	OutputValue_ = PDOutPort & IoMask_
	
endoffunc


// --- Write (DOutPort) ---

// Write full digital output port
// -- lAxis_         : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                     Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- DOutPortValue_ : 32-bit value written to DOutPort
function: uplIODOutPortWrite(l:lAxis_, l:DOutPortValue_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDOutPort = DOutPortValue_
	
endoffunc


// --- Bitwise Write (DOutPort) ---

// Set or clear digital output bit(s)
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- IoMask_  : Bit mask, IO_NUM_n from uplIO.puh2 (e.g. IO_NUM_1)
// -- Action_  : IO_WRITE_SET or IO_WRITE_CLEAR
function: uplIODOutPortWriteBit(l:lAxis_, l:IoMask_, l:Action_)
	
	AChooseAxis[AProgThread] = lAxis_
	
	switch (Action_)
		case IO_WRITE_SET
			PDOutPort = PDOutPort | IoMask_
			break
		case IO_WRITE_CLEAR
			PDOutPort = PDOutPort & (IO_MASK_ALL ^ IoMask_)
			break
		default
			break
		end
	
endoffunc


// Toggle digital output bit(s)
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- IoMask_  : Bit mask, IO_NUM_n from uplIO.puh2 (e.g. IO_NUM_1)
function: uplIODOutPortToggleBits(l:lAxis_, l:IoMask_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDOutPort = PDOutPort ^ IoMask_
	
endoffunc


// --- Write (DOutLog) ---

// Write full digital output log port
// -- lAxis_        : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                    Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- DOutLogValue_ : 32-bit value written to DOutLog
function: uplIODOutLogWrite(l:lAxis_, l:DOutLogValue_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDOutLog = DOutLogValue_
	
endoffunc


// --- Bitwise Write (DOutLog) ---

// Set or clear digital output log bit(s)
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- IoMask_  : Bit mask, IO_NUM_n from uplIO.puh2 (e.g. IO_NUM_1)
// -- Action_  : IO_WRITE_SET or IO_WRITE_CLEAR
function: uplIODOutLogWriteBit(l:lAxis_, l:IoMask_, l:Action_)
	
	AChooseAxis[AProgThread] = lAxis_
	
	switch (Action_)
		case IO_WRITE_SET
			PDOutLog = PDOutLog | IoMask_
			break
		case IO_WRITE_CLEAR
			PDOutLog = PDOutLog & (IO_MASK_ALL ^ IoMask_)
			break
		default
			break
	end
	
endoffunc


// Toggle digital output log bit(s)
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- IoMask_  : Bit mask, IO_NUM_n from uplIO.puh2 (e.g. IO_NUM_1)
function: uplIODOutLogToggleBits(l:lAxis_, l:IoMask_)
	
	AChooseAxis[AProgThread] = lAxis_
	PDOutLog = PDOutLog ^ IoMask_
	
endoffunc


// =============================================================================
// Analog input
// =============================================================================

// --- Config (AInMode[]) ---

// Configure analog input mode
// -- lAxis_      : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                  Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- InputIndex_ : Analog input number (1-based index into AInMode[])
// -- Mode_       : Analog mode value [ANALOG_* constants in uphGeneralConstants.puh2]
function: uplIOAInModeConfig(l:lAxis_, l:InputIndex_, l:Mode_)
	
	AChooseAxis[AProgThread] = lAxis_
	PAInMode[InputIndex_] = Mode_
	
endoffunc


// --- Read (AInPort[]) ---

// Read analog input value
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- Index_   : Analog input number (1-based); Index_ > 0
// -- Returns  : Analog input value [float]
function: f:AInValue_ = uplIOAInPortRead(l:lAxis_, l:Index_)
	
	AChooseAxis[AProgThread] = lAxis_
	AInValue_ = PAInPort[Index_]
	
endoffunc


// (Analog inputs are read-only — no Write)


// =============================================================================
// Analog output
// =============================================================================

// --- Config (AOutMode[]) ---

// Configure analog output mode
// -- lAxis_       : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                   Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- OutputIndex_ : Analog output number (1-based index into AOutMode[])
// -- Mode_        : Analog mode value [ANALOG_* constants in uphGeneralConstants.puh2]
function: uplIOAOutModeConfig(l:lAxis_, l:OutputIndex_, l:Mode_)
	
	AChooseAxis[AProgThread] = lAxis_
	PAOutMode[OutputIndex_] = Mode_
	
endoffunc


// --- Read (AOutPort[]) ---

// Read analog output value
// -- lAxis_   : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//               Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- Index_   : Analog output number (1-based); Index_ > 0
// -- Returns  : Analog output value [float]
function: f:AOutValue_ = uplIOAOutPortRead(l:lAxis_, l:Index_)
	
	AChooseAxis[AProgThread] = lAxis_
	AOutValue_ = PAOutPort[Index_]
	
endoffunc


// --- Write (AOutPort[]) ---

// Write analog output value
// -- lAxis_     : Apply on axis, value of 0 refers to A-axis, value of 1 to B-axis, and so on.
//                 Notice that the library includes constants definitions, such as A_AXIS, B_AXIS, ..., H_AXIS.
// -- Index_     : Analog output number (1-based); Index_ > 0
// -- AOutValue_ : Analog output value to write [float]
function: uplIOAOutPortWrite(l:lAxis_, l:Index_, f:AOutValue_)
	
	AChooseAxis[AProgThread] = lAxis_
	PAOutPort[Index_] = AOutValue_
	
endoffunc

