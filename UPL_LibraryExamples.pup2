endofmain


// =============================================================================
// uplIODInPortReadBit tests
// =============================================================================
// Verifies: uplIODInPortReadBit(lAxis_, IoMask_) with IO_NUM_n constants

function: testDInReadBitMask(l:lAxis_, l:IoMask_) local: l:PortValue_, l:Expected_, l:Actual_

	PortValue_ = uplIODInPortRead(lAxis_)
	Expected_ = PortValue_ & IoMask_
	Actual_ = uplIODInPortReadBit(lAxis_, IoMask_)

	if (Actual_ == Expected_)
		testPassCount = testPassCount + 1
		printf("!G!uplIODInPortReadBit PASS axis=%l mask=%l expected=%l actual=%l", lAxis_, IoMask_, Expected_, Actual_)
	else
		testFailCount = testFailCount + 1
		printf("!R!uplIODInPortReadBit FAIL axis=%l mask=%l expected=%l actual=%l", lAxis_, IoMask_, Expected_, Actual_)
	end

endoffunc


function: testDInReadBit(l:lAxis_) local: l:ZeroResult_

	testPassCount = 0
	testFailCount = 0

	ZeroResult_ = uplIODInPortReadBit(lAxis_, 0)
	if (ZeroResult_ == 0)
		testPassCount = testPassCount + 1
		printf("!G!uplIODInPortReadBit PASS mask=0 expected=0 actual=%l", ZeroResult_)
	else
		testFailCount = testFailCount + 1
		printf("!R!uplIODInPortReadBit FAIL mask=0 expected=0 actual=%l", ZeroResult_)
	end

	testDInReadBitMask(lAxis_, IO_NUM_1)
	testDInReadBitMask(lAxis_, IO_NUM_2)
	testDInReadBitMask(lAxis_, IO_NUM_3)
	testDInReadBitMask(lAxis_, IO_NUM_16)
	testDInReadBitMask(lAxis_, IO_NUM_32)
	testDInReadBitMask(lAxis_, IO_NUM_1 | IO_NUM_2)

	if (testFailCount == 0)
		printf("!G!uplIODInPortReadBit: ALL %l TESTS PASSED", testPassCount)
	else
		printf("!R!uplIODInPortReadBit: %l PASSED, %l FAILED", testPassCount, testFailCount)
	end

endoffunc


// =============================================================================
// uplIODOut write / read-back tests
// =============================================================================
// Verifies: uplIODOutPortWriteBit / uplIODOutPortReadBit / uplIODOutPortToggleBits
// WARNING: this test drives physical digital outputs on lAxis_. The original
//          DOutPort value is saved and restored, but do not run on a machine
//          where toggling outputs #1/#2/#8 is unsafe.

function: testDOutBit(l:lAxis_, l:IoMask_) local: l:SetRead_, l:ClrRead_

	uplIODOutPortWriteBit(lAxis_, IoMask_, IO_WRITE_SET)
	SetRead_ = uplIODOutPortReadBit(lAxis_, IoMask_)
	if (SetRead_ == IoMask_)
		testPassCount = testPassCount + 1
		printf("!G!DOut SET PASS mask=%l read=%l", IoMask_, SetRead_)
	else
		testFailCount = testFailCount + 1
		printf("!R!DOut SET FAIL mask=%l read=%l", IoMask_, SetRead_)
	end

	uplIODOutPortWriteBit(lAxis_, IoMask_, IO_WRITE_CLEAR)
	ClrRead_ = uplIODOutPortReadBit(lAxis_, IoMask_)
	if (ClrRead_ == 0)
		testPassCount = testPassCount + 1
		printf("!G!DOut CLEAR PASS mask=%l read=%l", IoMask_, ClrRead_)
	else
		testFailCount = testFailCount + 1
		printf("!R!DOut CLEAR FAIL mask=%l read=%l", IoMask_, ClrRead_)
	end

endoffunc


function: testDOutWriteReadBit(l:lAxis_) local: l:Original_, l:ToggleRead_

	testPassCount = 0
	testFailCount = 0

	Original_ = uplIODOutPortRead(lAxis_)
	uplIODOutPortWrite(lAxis_, 0)

	testDOutBit(lAxis_, IO_NUM_1)
	testDOutBit(lAxis_, IO_NUM_2)
	testDOutBit(lAxis_, IO_NUM_8)

	uplIODOutPortWrite(lAxis_, 0)
	uplIODOutPortToggleBits(lAxis_, IO_NUM_1)
	ToggleRead_ = uplIODOutPortReadBit(lAxis_, IO_NUM_1)
	if (ToggleRead_ == IO_NUM_1)
		testPassCount = testPassCount + 1
		printf("!G!DOut TOGGLE PASS read=%l", ToggleRead_)
	else
		testFailCount = testFailCount + 1
		printf("!R!DOut TOGGLE FAIL read=%l", ToggleRead_)
	end

	uplIODOutPortToggleBits(lAxis_, IO_NUM_1)
	ToggleRead_ = uplIODOutPortReadBit(lAxis_, IO_NUM_1)
	if (ToggleRead_ == 0)
		testPassCount = testPassCount + 1
		printf("!G!DOut TOGGLE-BACK PASS read=%l", ToggleRead_)
	else
		testFailCount = testFailCount + 1
		printf("!R!DOut TOGGLE-BACK FAIL read=%l", ToggleRead_)
	end

	uplIODOutPortWrite(lAxis_, Original_)

	if (testFailCount == 0)
		printf("!G!uplIODOut write/read: ALL %l TESTS PASSED", testPassCount)
	else
		printf("!R!uplIODOut write/read: %l PASSED, %l FAILED", testPassCount, testFailCount)
	end

endoffunc
