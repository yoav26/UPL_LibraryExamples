#include uplUtility.puh2
#include uplMotion.puh2
#include uplCNC.puh2
#include uplIO.puh2
// 
#information   UPL library examples and tests — uncomment one block in main to run
#information   See README.md in this folder
// 
// Main task (Task 1)
// ------------------
// Dynamic allocation ranges: [Tasks],[Functions],[#definevar],[#definevar:f],[#definevar:l],[#definevar:d]
//

main([10,30],[5,61],[800,1000],[50,100],[50,100],[50,100])


// =============================================================================
